{
  "name": "gather-ui-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual German and Persian UI prototype for Gather",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/main.css --style=expanded --source-map",
    "watch:css": "sass --watch assets/scss/main.scss:assets/css/main.css --style=expanded",
    "serve": "http-server . -p 4173 -c-1",
    "check:links": "node scripts/check-links.js",
    "check:localization": "node scripts/check-localization.js"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "sass": "^1.90.0"
  }
}
